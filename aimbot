local function updateExcludeList()
    for _, child in ipairs(ListScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local searchFilter = string.lower(SearchBox.Text)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pNameLower = string.lower(p.Name)
            local pDisplayNameLower = string.lower(p.DisplayName)
            
            if string.find(pNameLower, searchFilter) or string.find(pDisplayNameLower, searchFilter) then
                local pBtn = Instance.new("TextButton")
                pBtn.Name = p.Name
                pBtn.Size = UDim2.new(1, 0, 0, 24)
                pBtn.Font = Enum.Font.Gotham
                pBtn.TextSize = 12
                pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
                
                local function updateBtnVisual()
                    if ExcludedPlayers[p.Name] then
                        pBtn.BackgroundColor3 = Color3.fromRGB(150, 35, 35)
                        pBtn.TextColor3 = Color3.fromRGB(255, 200, 200)
                    else
                        pBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                        pBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
                    end
                end
                
                updateBtnVisual()
                
                local bCorner = Instance.new("UICorner")
                bCorner.CornerRadius = UDim.new(0, 4)
                bCorner.Parent = pBtn
                
                pBtn.MouseButton1Click:Connect(function()
                    ExcludedPlayers[p.Name] = not ExcludedPlayers[p.Name]
                    updateBtnVisual()
                end)
                
                pBtn.Parent = ListScroll
            end
        end
    end
    ListScroll.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
    Container.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 15)
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(updateExcludeList)
Players.PlayerAdded:Connect(function(p) task.wait(0.5) updateExcludeList() end)
Players.PlayerRemoving:Connect(function(p) ExcludedPlayers[p.Name] = nil updateExcludeList() end)
